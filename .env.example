# ============================================
# Z-API WhatsApp Integration
# ============================================

# ID da instância WhatsApp no Z-API
# Obtenha em: https://z-api.io (após conectar sua conta)
Z_API_INSTANCE_ID=seu_instance_id_aqui

# Token de autenticação Z-API
# Obtenha em: https://z-api.io (painel -> credenciais)
Z_API_TOKEN=seu_token_aqui

# URL base da aplicação (para registrar webhook)
# Exemplo: https://seu-dominio.com ou https://seu-app-railway.up.railway.app
APP_BASE_URL=http://localhost:3000

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=sua_url_supabase_aqui
SUPABASE_KEY=sua_chave_supabase_aqui

# ============================================
# NestJS Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Webhook Configuration
# ============================================

# URL completa do webhook (sem trailing slash)
# Será usado para registrar em https://z-api.io
# Exemplo: https://seu-dominio.com/api/whatsapp/webhook
WEBHOOK_URL=http://localhost:3000/api/whatsapp/webhook

# ============================================
# Optional: Redis/Message Queue
# ============================================
# Se usar Redis para fila de processamento
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
